          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
        },
        "fileImage": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
        },
        "fileVideo": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
        },
        "fileAudio": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"

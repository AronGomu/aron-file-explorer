{
  "name": "explr",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:themes": "vite --config vite.themes.config.js --host 127.0.0.1 --port 1422 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:themes": "vitest run --project themes",
    "test:themes:visual": "playwright test --config playwright.themes.config.js",
    "test:themes:audit": "node scripts/audit-theme-colors.mjs",
    "tauri": "nix develop --no-warn-dirty --command tauri",
    "tauri:build:macos": "cargo tauri build --target aarch64-apple-darwin && cd src-tauri/scripts && ./post-build.sh",
    "tauri:build:intel": "cargo tauri build --target x86_64-apple-darwin && cd src-tauri/scripts && ./post-build.sh",
    "build:universal": "./build-universal.sh",
    "dist": "./build-universal.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "8.20.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "vite": "^6.0.3",
    "vitest": "3.2.7"
  }
}
